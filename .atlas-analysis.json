  "keyFeatures": [
    "Full CRUD operations for movies (peliculas) with title, genre, and duration fields",
    "Screening room (salas) management with name and capacity",
    "Show function (funciones) scheduling linking movies to rooms with a time slot",
    "Ticket (tickets) management with seat assignment and pricing linked to a function",
    "Reservation (reservaciones) management linking customers to tickets with date tracking",
    "Date-range filtering for reservations",
    "Ticket-reservation relationship removal endpoint",
    "In-memory data store with UUID-based IDs",
    "Consistent JSON response envelope: { data, message } with HTTP status codes"
  ],
  "publicApiSurface": [
    "GET /peliculas",
    "GET /peliculas/grupo/ultimas5",
    "GET /peliculas/:id",
    "POST /peliculas/create",
    "PUT /peliculas/update/:id",
    "DELETE /peliculas/delete/:id",
    "GET /salas",
    "GET /salas/:id",
    "POST /salas/create",
    "PUT /salas/update/:id",
    "DELETE /salas/delete/:id",
    "GET /funciones",
