    "PUT /funciones/update/:id",
    "DELETE /funciones/delete/:id",
    "GET /tickets",
    "GET /tickets/:id",
    "POST /tickets/create",
    "PUT /tickets/update/:id",
    "DELETE /tickets/delete/:id",
    "GET /reservaciones",
    "GET /reservaciones/:id",
    "GET /reservaciones/busqueda/fecha?inicio=&fin=",
    "POST /reservaciones/create",
    "PUT /reservaciones/update/:id",
    "DELETE /reservaciones/delete/:id",
    "DELETE /reservaciones/delete-relation/:id/ticket"
  ]
